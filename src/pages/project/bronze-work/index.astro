<ProjectLayout backLink="/" nextLink="/project/bronze-work/2" title="bronze work" description="examples of bronze castings done over several years.">
  <Image src={beeMachineImg} alt="bee machine" />
  <Image src={beeDetailImg} alt="bee machine detail" />
