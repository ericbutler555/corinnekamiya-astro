---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>corinne kamiya</title>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="personal website of art, food and life" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <div class="wrapper">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  :root {
    --color-teal: #8cccca;
    --color-gray: #666;
    --color-light-gray: #999;
  }
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    font-family: Arial, sans-serif;
    font-size: 16px;
    line-height: 1.4;
  }
  a {
    text-decoration: none;
    color: var(--color-teal);
  }
  a:hover,
  a:focus {
    color: var(--color-gray);
  }
  h1 {
    font-size: 1rem;
    font-weight: normal;
    color: var(--color-gray);
  }
  p {
    font-size: 0.875rem;
  }
  img {
    display: inline-block;
    max-width: 100%;
    height: auto;
  }
</style>

<style>
  .wrapper {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
</style>
