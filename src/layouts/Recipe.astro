---
import { Image } from "astro:assets";
import Layout from "./Layout.astro";
import backImg from "../assets/img/back_thumb.jpg";
---

<Layout>
  <slot />
  <a class="back-link" href="/recipes"><Image src={backImg} alt="back to recipes" /></a>
</Layout>

<style>
  .back-link {
    display: inline-block;
    margin-top: 1rem;
  }
</style>
